# Single admin password (build-spec §3 screen 1)
ADMIN_PASSWORD=change-me

# 32+ random chars; signs the session cookie. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string

# Local dev: sqlite file. Production: Turso libsql URL + token.
DATABASE_URL=file:local.db
# DATABASE_URL=libsql://na-office-hr-xxx.turso.io
# DATABASE_AUTH_TOKEN=
